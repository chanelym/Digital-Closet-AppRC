<!doctype html>
<html>
<head>
    <title>My Digital Closet</title>
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body>
<div class="container">
<div class="col-sm-6 col-sm-offset-3">
    <form method="POST" action="/closet/create"> 
        <div class="form-group">
            <label>Name</label>
            <input type="text" class="form-control" placeholder="e.g. Zoom Vomero 5" name="name" required>
        </div>
         <div class="form-group">
            <label>Color</label>
            <input type="text" class="form-control" placeholder="e.g. Black" name="color" required>
        </div>
         <div class="form-group">
            <label>Brand</label>
            <input type="text" class="form-control" placeholder="e.g. Nike" name="brand" required>
        </div>
         <div class="form-group">
            <label>Image</label>
            <input type="text" class="form-control" placeholder="Add image link or write none" name="imageURL" required>
        </div>
         <div class="form-group">
            <label>Category</label>
            <input type="text" class="form-control" placeholder="e.g. Tops/ Shoes/ Bottoms" name="category" required>
        </div>
        <button type="submit" class="button">Create</button>
        <a href="/closet" button type="submit" class="myClosetButton">My Closet</button></a></form>
<script src="main.js"></script>
</body>
</html>
